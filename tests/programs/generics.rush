struct Pair[A, B]
  derive Clone
  first: A
  second: B
end

impl[A: Show, B: Show] Show for Pair[A, B]
  def to_s(&self)
    "<#{@first}, #{@second}>"
  end
end

def flip[A, B](p: Pair[A, B]) -> Pair[B, A]
  let Pair { first: a, second: b } = p
  Pair { first: b, second: a }
end

def main
  let p = Pair { first: 1, second: "x" }
  puts("#{p} #{flip(p.clone)} #{flip(flip(p.clone))}")
  let mut q = Pair { first: true, second: 2.5 }
  q.first = false
  puts("#{q}")
end
