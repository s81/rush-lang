struct Noisy
  name: String
end

impl Drop for Noisy
  def drop(&mut self)
    puts("drop #{@name}")
  end
end

def main
  let mut a = 0
  for i in 1..4
    a += i
  end
  let mut b = 0
  for i in 1...4
    b += i
  end
  puts("#{a} #{b}")                  # 10 6
  let mut odd = 0
  for i in 0..9
    if i % 2 == 0
      next
    end
    odd += i
  end
  puts("#{odd}")                     # 1+3+5+7+9 = 25
  let mut n = 0
  while true
    n += 1
    if n == 3
      break
    end
  end
  puts("#{n}")                       # 3
  let mut k = 0
  let found = loop
    k += 1
    let t = Noisy { name: "iter #{k}" }
    if k == 2
      let inner = Noisy { name: "inner" }
      break k * 10
    end
  end
  puts("#{found}")                   # drops: iter 1; then inner, iter 2 on break; then 20
  for _ in 5...5
    puts("never")
  end
  let mut last = 0
  for i in 9223372036854775806..9223372036854775807
    last = i
  end
  puts("#{last}")                    # no overflow at the top of Int
end
