def pair_up(a, b)
  (a, b)
end

def main
  let t = pair_up(1, "one")
  puts("#{t.0} #{t.1}")
  let (n, s) = t
  puts("#{n} #{s} #{n == 1}")
  case (n, pair_up(true, 2.5))
  in (1, (true, f)) if f > 2.0 then puts("big #{f}")
  in (1, (true, f)) then puts("small #{f}")
  in (_, _) then puts("other")
  end
end
